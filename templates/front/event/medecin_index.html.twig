{% extends 'baseFrontOffice.html.twig' %}

{% block title %}SAHATECH - {{ 'Événements'|trans }}{% endblock %}

{% block body %}
<style>
    .event-image {
        width: 250px; /* Largeur fixe */
        height: 350px; /* Hauteur fixe */
        object-fit: cover; /* Remplit le conteneur en gardant les proportions */
        border-radius: 10px;
        background-color: #f5f5f5; /* Couleur de fond pour les espaces vides */
        padding: 5px; /* Ajoute un petit espace autour de l'image */
        display: block;
        margin: auto;
    }

    .post-grid .card {
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .post-grid .card:hover {
        transform: translateY(-5px);
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
    }
</style>
<section id="latest-blog" class="padding-large">
    <div class="container">
        <div class="row">
            <div class="display-header">
                <h2 class="display-5 fw-bold text-dark text-center">{{ 'Nos événements récents'|trans }}</h2>
            </div>

            <!-- Carte interactive avec Leaflet -->

            <!-- Onglets pour événements actifs et archivés -->
            <ul class="nav nav-tabs mt-4" id="eventTabs">
                <li class="nav-item">
                    <a class="nav-link active" id="active-tab" data-bs-toggle="tab" href="#active-events">
                        {{ 'Événements Actifs'|trans }}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="archived-tab" data-bs-toggle="tab" href="#archived-events">
                        {{ 'Événements Archivés'|trans }}
                    </a>
                </li>
            </ul>

            <div class="tab-content mt-4">
                <!-- Événements Actifs -->
                <div class="tab-pane fade show active" id="active-events">
                    <div class="post-grid d-flex flex-wrap mt-4">
                        {% for event in events_active %}
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-5">
                                <div class="card-item pe-3">
                                    <div class="card border-0 bg-transparent">
                                        <div class="card-image position-relative">
                                            <img src="{{ event.affiche ? asset('uploads/affiches/' ~ event.affiche) : asset('images/default-event.png') }}" 
                                                 alt="{{ 'Affiche de'|trans }} {{ event.title }}" 
                                                 class="event-image">
                                            <span class="bg-primary-dim text-light position-absolute text-uppercase text-capitalize">
                                                {{ event.categorie.nom }}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-body p-3 mt-2">
                                        <div class="meta-date">
                                            <i class="bi bi-calendar"></i> {{ event.startDate|date('M d, Y') }} - {{ event.endDate|date('M d, Y') }}
                                        </div>
                                        <h3 class="card-title fs-3 text-capitalize fw-semibold mt-3">
                                            <a href="{{ path('front_medecin_event_show', {'id': event.id}) }}">
                                                {{ event.title }}
                                            </a>
                                        </h3>
                                        <p>
                                            {{ event.description|slice(0, 100) }}...
                                            <a href="{{ path('front_medecin_event_show', {'id': event.id}) }}" class="text-decoration-underline">
                                                <em>{{ 'Lire plus'|trans }}</em>
                                            </a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <p>{{ 'Aucun événement actif disponible.'|trans }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Événements Archivés -->
                <div class="tab-pane fade" id="archived-events">
                    <div class="post-grid d-flex flex-wrap mt-4">
                        {% for event in events_archived %}
                        {% if event.isExpired %}
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-5">
                                <div class="card-item pe-3">
                                    <div class="card border-0 bg-transparent">
                                        <div class="card-image position-relative">
                                            <img src="{{ event.affiche ? asset('uploads/affiches/' ~ event.affiche) : asset('images/default-event.png') }}" 
                                                 alt="{{ 'Affiche de'|trans }} {{ event.title }}" 
                                                 class="event-image">
                                            <span class="bg-secondary text-light position-absolute text-uppercase text-capitalize">
                                                {{ event.categorie.nom }}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-body p-3 mt-2">
                                        <div class="meta-date">
                                            <i class="bi bi-calendar"></i> {{ event.startDate|date('M d, Y') }} - {{ event.endDate|date('M d, Y') }}
                                        </div>
                                        <h3 class="card-title fs-3 text-capitalize fw-semibold mt-3">
                                            <a href="{{ path('front_medecin_event_show', {'id': event.id}) }}">
                                                {{ event.title }}
                                            </a>
                                        </h3>
                                        <p>
                                            {{ event.description|slice(0, 100) }}...
                                            <a href="{{ path('front_medecin_event_show', {'id': event.id}) }}" class="text-decoration-underline">
                                                <em>{{ 'Lire plus'|trans }}</em>
                                            </a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        {% else %}
                            <div class="col-12">
                                <p>{{ 'Aucun événement archivé disponible.'|trans }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

                    <div id="map" style="height: 500px; width: 100%; margin-top: 20px;"></div>

    </div>
</section>

<!-- Script pour Leaflet.js -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    var map = L.map('map').setView([36.8065, 10.1815], 10); // Centré sur Tunis

    // Ajouter OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // Ajouter les événements sur la carte
    var events = [
        {% for event in events_active %}
            {% if event.latitude and event.longitude %}
                { lat: {{ event.latitude }}, lng: {{ event.longitude }}, title: "{{ event.title }}" },
            {% endif %}
        {% endfor %}
    ];

    // Marqueurs sur la carte
    events.forEach(event => {
        L.marker([event.lat, event.lng])
            .addTo(map)
            .bindPopup(`<strong>${event.title}</strong>`);
    });
});
</script>

<!-- Leaflet CSS et JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

{% endblock %}
