{% extends 'baseBackOffice.html.twig' %}

{% block title %}Reponse index{% endblock %}

{% block body %}

    <h1 class="tt">Reponse index</h1>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Contenu</th>
                    <th>Date_reponse</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for reponse in reponses %}
                <tr>
                    <td>{{ reponse.contenu }}</td>
                    
                    <td>{{ reponse.dateReponse ? reponse.dateReponse|date('Y-m-d H:i:s') : ''}}</td>
                    <td>
                        <a href="{{ path('app_reponse_controller_php_show', {'id': reponse.id}) }}">show</a>
                        <a href="{{ path('app_reponse_controller_php_edit', {'id': reponse.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_reponse_controller_php_new') }}">Create new</a>
    
<style>
  /* Table styling */
.table-container {
    max-width: 900px;
    margin: 40px auto;
    overflow-x: auto;
}

.table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    overflow: hidden;
}

.table th, .table td {
    padding: 15px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

.table th {
    background-color: #00B4D8;
    color: white;
}

.table tbody tr:nth-child(even) {
    background-color: #f9f9f9;
}

/* Styling des liens */
a {
    text-decoration: none;
    padding: 8px 12px;
    margin-right: 5px;
    border-radius: 6px;
    transition: background 0.3s ease;
}

a[href*="show"] {
    background-color: #28a745;
    color: white;
}

a[href*="edit"] {
    background-color: #ffc107;
    color: black;
}

a[href*="new"] {
    display: block;
    text-align: center;
    background-color: #007bff;
    color: white;
    padding: 12px;
    width: fit-content;
    margin: 20px auto;
    border-radius: 8px;
}

a:hover {
    opacity: 0.8;
}
</style>
{% endblock %}


