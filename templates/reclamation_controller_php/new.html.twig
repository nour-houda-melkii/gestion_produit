{% extends 'baseFrontOffice.html.twig' %}

{% block title %}New Reclamation{% endblock %}

{% block body %}
 <main id="main" class="main">
  <div class="cont">
    <div class="hea">
    
      <a href="{{ path('app_reclamation_controller_php_index') }}" class="bbtn btn-back">Back to List</a>
    </div>

    <div class="form-wrapper">
      {{ include('reclamation_controller_php/_form.html.twig') }}
    </div>
  </div>
  </main>
<style>
  .cont {
    max-width: 800px;
    margin: 40px auto;
    padding: 20px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .hea {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .hea h1 {
    color: #2c3e50;
    font-size: 28px;
    font-weight: 600;
    margin: 0;
  }

  .btn-back {
    background-color: #00B4D8;
    border: none;
    color: white;
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .btn-back:hover {
    background-color: #0099b3;
    transform: translateY(-2px);
  }

  .form-wrapper {
    margin-top: 20px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-weight: 500;
    margin-bottom: 8px;
    color: #34495e;
    font-size: 16px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    color: #333;
    background-color: #f9f9f9;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: #00B4D8;
    outline: none;
    background-color: #fff;
    box-shadow: 0 0 8px rgba(0, 180, 216, 0.2);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    background-color: #00B4D8;
    border: none;
    color: white;
    padding: 14px 24px;
    font-size: 18px;
    cursor: pointer;
    border-radius: 8px;
    width: 100%;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .btn-submit:hover {
    background-color: #0099b3;
    transform: translateY(-2px);
  }
</style>
{% endblock %}
