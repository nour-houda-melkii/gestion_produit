    <h2>Réclamation de type :</h2>
    {{ form_start(form) }} #}

{{ form_start(form) }}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Gestion de la case à cocher "Ajouter une photo ?"
        let photoCheckbox = document.querySelector("#{{ form.addPhoto.vars.id }}");
        let photoInput = document.querySelector(".photo-input");

        if (photoCheckbox && photoInput) {
            photoCheckbox.addEventListener("change", function () {
                photoInput.classList.toggle("active", photoCheckbox.checked);
            });

            // Initialiser l'état du champ "photo" au chargement de la page
            photoInput.classList.toggle("active", photoCheckbox.checked);
        }

        // Gestion de la case à cocher "Médecin ?"
        let medecinCheckbox = document.querySelector("#{{ form.addidmedcein.vars.id }}");
        let medecinNameInput = document.querySelector(".medcein-name-input");

        if (medecinCheckbox && medecinNameInput) {
            medecinCheckbox.addEventListener("change", function () {
                medecinNameInput.classList.toggle("active", medecinCheckbox.checked);
            });

            // Initialiser l'état du champ "nom du médecin" au chargement de la page
            medecinNameInput.classList.toggle("active", medecinCheckbox.checked);
        }
    });
</script>
<div class="tt">
    <h2>Réclamation de type :</h2>

    <div class="group1">
        {{ form_label(form.description) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="custom-checkbox-group">
        {{ form_widget(form.addidmedcein) }}
        {{ form_label(form.addidmedcein) }}
    </div>

    <div class="group1 medecin medcein-name-input">
        {{ form_label(form.idmedecin) }}
        {{ form_widget(form.idmedecin, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="group1">
        {{ form_label(form.date_reclamation) }}
        {{ form_widget(form.date_reclamation, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="custom-checkbox-group">
        {{ form_widget(form.addPhoto) }}
        {{ form_label(form.addPhoto) }}
    </div>

    <div class="group1 input photo-input">
        {{ form_label(form.photo) }}
        {{ form_widget(form.photo, {'attr': {'class': 'form-control'}}) }}

        {# Afficher un aperçu de la photo si elle existe #}
        {% if reclamation.photo %}
            <div class="ccustomm ">
                <img src="{{ asset('upload/images/' ~ reclamation.photo) }}" alt="Photo">
            </div>
        {% else %}
            <div class="ccustomm">
                <p>Aucune photo disponible</p>
            </div>
        {% endif %}
    </div>

    <div class="group1">
        {{ form_label(form.typeReclamation) }}
        {{ form_widget(form.typeReclamation, {'attr': {'class': 'form-control'}}) }}
    </div>

    <button class="ccct">{{ button_label|default('Enregistrer') }}</button>
</div>
{{ form_end(form) }}
