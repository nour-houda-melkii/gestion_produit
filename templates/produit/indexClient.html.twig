{% extends 'baseFrontOffice.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    /* Custom Styles for Product Cards */
    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .card-img-top {
      width:100%; /* Ensure the image takes the full width of the card */
      height:100%; /* Allow the height to adjust based on the image's aspect ratio */
      object-fit: cover; /* Ensure the image covers the area without distortion */
      border-radius: 10px 10px 0 0;
    }

    .card-body {
      padding: 1.5rem;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: #333;
    }

    .card-text {
      font-size: 0.9rem;
      color: #555;
      margin-bottom: 0.5rem;
    }

    .text-warning {
      color: #ffc107 !important;
      font-weight: 500;
    }

    .btn-outline-primary {
      border-color: #007bff;
      color: #007bff;
      transition: background-color 0.3s ease, color 0.3s ease;
      font-weight: 500;
    }

    .btn-outline-primary:hover {
      background-color: #007bff;
      color: #fff;
    }

    .btn-outline-danger {
      border-color: #dc3545;
      color: #dc3545;
      transition: background-color 0.3s ease, color 0.3s ease;
      font-weight: 500;
    }

    .btn-outline-danger:hover {
      background-color: #dc3545;
      color: #fff;
    }

    .search-results {
      position: absolute;
      z-index: 1000;
      background: white;
      border: 1px solid #ddd;
      max-height: 200px;
      overflow-y: auto;
      width: 100%;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .search-results .result-item {
      padding: 10px;
      cursor: pointer;
      border-bottom: 1px solid #ddd;
    }

    .search-results .result-item:hover {
      background-color: #f8f9fa;
    }

    .comment-card {
      margin-top: 10px;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 10px;
      background-color: #f9f9f9;
    }

    .comment-card small {
      color: #777;
    }

    .comment-form textarea {
      resize: none;
    }
  </style>
{% endblock %}
{% block body %}
  <section id="products" class="py-5">
    <div class="container">
      <!-- Search Form -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <form method="get" action="{{ path('front_list') }}" class="d-flex">
          <input type="text" name="search" id="search-input" class="form-control me-2" placeholder="Search products..." value="{{ searchQuery }}">
          <button type="submit" class="btn btn-primary btn-sm">Search</button>
          {% if searchQuery is not empty %}
            <a href="{{ path('front_list') }}" class="btn btn-secondary btn-sm ms-2">Reset</a>
          {% endif %}
        </form>
      </div>

      <!-- Search Results -->
      <div id="search-results" class="search-results"></div>

      <!-- Filter by Category -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <form method="get" action="{{ path('front_list') }}" class="d-flex">
          <select name="category" class="form-select me-2">
            <option value="">All Categories</option>
            {% for category in categories %}
              <option value="{{ category.id }}" {{ selectedCategory == category.id ? 'selected' : '' }}>
                {{ category.name }}
              </option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
        </form>
      </div>

      <div class="row" id="product-list">
        {% for produit in produits %}
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
              <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.name }}">
              <div class="card-body">
                <h5 class="card-title">{{ produit.name }}</h5>
                <p class="card-text">{{ produit.desciption }}</p>
                <p class="card-text"><strong>Price:</strong> {{ produit.price }} Dt</p>
                {% if produit.quantity < 3 %}
                  <p class="card-text text-warning"><strong>Alert: This product may be out of stock soon!</strong></p>
                {% endif %}

                {# Add to Cart Form #}
                {% if app.user %}
                  <form action="{{ path('add_to_cart', {'id': produit.id}) }}" method="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart' ~ produit.id) }}">
                    <button type="submit" class="btn btn-outline-primary w-100 mb-2">Add To Cart</button>
                  </form>
                {% endif %}

                {# Toggle Favorite Form #}
                {% if app.user %}
                  <form action="{{ path('toggle_favorite', {'id': produit.id}) }}" method="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_favorite' ~ produit.id) }}">
                    <button type="submit" class="btn btn-outline-danger w-100">
                      {% if produit in app.user.favoris|map(f => f.produit) %}
                        ❤️ Remove from Favorites
                      {% else %}
                        🤍 Add to Favorites
                      {% endif %}
                    </button>
                  </form>
                {% endif %}

                {# Comment Form #}
                {% if app.user %}
                  <form action="{{ path('produit_comment', {'id': produit.id}) }}" method="POST" class="mt-3">
                    <textarea name="content" class="form-control mb-2" placeholder="Add a comment..." required></textarea>
                    <input type="hidden" name="_token" value="{{ csrf_token('comment' ~ produit.id) }}">
                    <button type="submit" class="btn btn-outline-success btn-sm">Submit Comment</button>
                  </form>
                {% endif %}

                {# Display Comments #}
                <div class="mt-3">
                  <h6>Comments:</h6>
                  {% for commentaire in produit.commentaires %}
                    <div class="comment-card mb-2">
                      <p class="card-text">{{ commentaire.content }}</p>
                      <small class="text-muted">By {{ commentaire.user.firstName }} on {{ commentaire.createdAt|date('Y-m-d H:i') }}</small>
                      {% if app.user and app.user == commentaire.user %}
                        <form action="{{ path('comment_delete', {'id': commentaire.id}) }}" method="POST" class="d-inline">
                          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
                          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="col-1 2">
            <p class="text-center">No products found</p>
          </div>
        {% endfor %}
      </div>
      <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(produits) }}
</div>
    </div>
  </section>

  <script>
    document.getElementById('search-input').addEventListener('input', function() {
      const query = this.value;
      const searchResults = document.getElementById('search-results');

      if (query.length > 2) {
        fetch(`/produit/search?query=${query}`)
          .then(response => response.json())
          .then(data => {
            searchResults.innerHTML = '';
            data.forEach(item => {
              const resultItem = document.createElement('div');
              resultItem.className = 'result-item';
              resultItem.innerHTML = `
                <img src="/uploads/images/${item.image}" alt="${item.name}" style="width: 50px; height: 50px;">
                <span>${item.name} - ${item.price} Dt</span>
              `;
              resultItem.addEventListener('click', () => {
                window.location.href = `/produit/${item.id}`;
              });
              searchResults.appendChild(resultItem);
            });
          });
      } else {
        searchResults.innerHTML = '';
      }
    });
  </script>
{% endblock %}