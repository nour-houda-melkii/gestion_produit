<!DOCTYPE html>
<html>

<head>
  <title>{% block title %}Welcome!{% endblock %}</title>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="format-detection" content="telephone=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="author" content="">
  <meta name="keywords" content="">
  <meta name="description" content="">

  {% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ asset('assetsFrontOffice/css/bootstrap.min.css') }}">
  <link rel="stylesheet" type="text/css" href="{{ asset('assetsFrontOffice/style.css') }}">
  <link rel="stylesheet" type="text/css" href="{{ asset('../../cdn.jsdelivr.net/npm/swiper%409/swiper-bundle.min.css') }}">
  <link rel="preconnect" href="https://fonts.googleapis.com/">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@200;300;400;500;600;700;800;900&amp;display=swap"
    rel="stylesheet">
  <link href="{{ asset('assetsBackOffice/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
  <style>
    .cart-icon {
      position: relative;
      font-size: 24px;
      text-decoration: none;
    }
    #cart-count, #favorite-count {
      position: absolute;
      top: -10px;
      right: -10px;
      background-color: red;
      color: white;
      border-radius: 50%;
      padding: 2px 6px;
      font-size: 12px;
    }
    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }
    .card-img-top {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 10px 10px 0 0;
    }
    .card-body {
      padding: 1.5rem;
    }
    .card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: #333;
    }
    .card-text {
      font-size: 0.9rem;
      color: #555;
      margin-bottom: 0.5rem;
    }
    .text-warning {
      color: #ffc107 !important;
      font-weight: 500;
    }
    .btn-outline-primary {
      border-color: #007bff;
      color: #007bff;
      transition: background-color 0.3s ease, color 0.3s ease;
      font-weight: 500;
    }
    .btn-outline-primary:hover {
      background-color: #007bff;
      color: #fff;
    }
    .btn-outline-danger {
      border-color: #dc3545;
      color: #dc3545;
      transition: background-color 0.3s ease, color 0.3s ease;
      font-weight: 500;
    }
    .btn-outline-danger:hover {
      background-color: #dc3545;
      color: #fff;
    }
  </style>
  {% endblock %}

  {% block javascripts %}
  <script src="{{ asset('assetsFrontOffice/js/modernizr.js') }}"></script>
  <script src="{{ asset('assetsFrontOffice/js/jquery-1.11.0.min.js') }}"></script>
  <script src="{{ asset('assetsFrontOffice/js/swiper-bundle.min.js') }}"></script>
  <script type="text/javascript" src="{{ asset('assetsFrontOffice/js/bootstrap.bundle.min.js') }}"></script>
  <script type="text/javascript" src="{{ asset('assetsFrontOffice/js/plugins.js') }}"></script>
  <script type="text/javascript" src="{{ asset('assetsFrontOffice/js/script.js') }}"></script>
  <script src="{{ asset('assetsFrontOffice/js/iconify-icon.min.js') }}"></script>
  {% endblock %}
</head>

<body data-bs-spy="scroll" data-bs-target="#header-nav" tabindex="0">
  {% block header %}
  <header id="header">
    <nav class="header-top">
      <div class="container">
        <div class="row justify-content-between align-items-center">
          <div class="col-lg-5 col-md-4 col-sm-6 p-0 m-0">
            <a class="" href="index-2.html">
              <img src="{{ asset('assetsFrontOffice/images/logo.svg') }}" width="150">
            </a>
          </div>
          <div class="col-lg-4 col-md-4 d-md-block d-sm-none">
            <ul class="contact-list d-flex justify-content-lg-end flex-wrap list-unstyled m-0">
              <li class="ps-xl-3">
                <svg class="phone primary-color" width="24" height="24">
                  <use xlink:href="#phone"></use>
                </svg>70 685 685
              </li>
            </ul>
          </div>
          <div class="col-lg-3 col-md-4 col-sm-6">
            {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
              <div class="btn-book text-end">
                <a href="{{ path('app_login') }}" class="btn btn-sm btn-outline-primary btn-pill text-uppercase">Login</a>
                <a href="{{ path('choix_inscription') }}" class="btn btn-sm btn-outline-primary btn-pill text-uppercase">Inscription</a>
              </div>
            {% else %}
              <li class="nav-item dropdown pe-3">
                <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                  <span class="d-none d-md-block dropdown-toggle ps-5" style="color: #00B4D8;">
                    {{ app.user.firstName }} {{ app.user.lastName }}
                  </span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                  <li class="dropdown-header">
                    <h6>{{ app.user.firstName }} {{ app.user.lastName }}</h6>
                  </li>
                  <li>
                    <hr class="dropdown-divider">
                  </li>
                  <li>
                    <a class="dropdown-item d-flex align-items-center" href="{{ path('profile_patient') }}">
                      <i class="bi bi-person"></i>
                      <span>My Profile</span>
                    </a>
                  </li>
                  <li>
                    <hr class="dropdown-divider">
                  </li>
                  <li>
                    <a class="dropdown-item d-flex align-items-center" href="{{ path('profile_patient') }}">
                      <i class="bi bi-gear"></i>
                      <span>Account Settings</span>
                    </a>
                  </li>
                  <li>
                    <hr class="dropdown-divider">
                  </li>
                  <li>
                    <a class="dropdown-item d-flex align-items-center" href="{{ path('app_logout') }}">
                      <i class="bi bi-box-arrow-right"></i>
                      <span>Sign Out</span>
                    </a>
                  </li>
                </ul>
              </li>
            {% endif %}
          </div>
        </div>
      </div>
    </nav>

    <nav id="primary-header" nav class="navbar navbar-expand-lg shadow-none" aria-label="navbar" height="30">
      <div class="container">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-primary"
          aria-controls="navbar-primary" aria-expanded="false" aria-label="Toggle navigation">
          <svg class="navbar-icon mt-3 primary-color-500 bg-light" width="50" height="50">
            <use xlink:href="#navbar-icon"></use>
          </svg>
        </button>
        <div class="header-bottom collapse navbar-collapse bg-light border-radius-10 py-2" id="navbar-primary">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item ps-4 pe-4 border-right">
              <a class="nav-link text-dark active p-0 mt-3 mt-lg-0" aria-current="page" href="#intro">Home</a>
            </li>
            <li class="nav-item ps-4 pe-4 border-right">
              <a class="nav-link text-dark p-0" href="{{ path('app_produit_show') }}">Products</a>
            </li>
            {% if app.user is not null %}
            <li class="nav-item ps-4 pe-4 border-right">
              <a class="nav-link text-dark p-0" href="{{path('mes_consultations')}}">Consultations</a> 
            </li>
            <li class="nav-item ps-4 pe-4 border-right">
              <a href="{{ path('liste_medecins') }}" class="nav-link text-dark p-0" >Liste des Médecins</a>
            </li>
            {% endif %}
            <li class="nav-item ps-4 pe-4 border-right">
              <a href="{{ path('front_medecin_event_index') }}">Events</a>
            </li>
            <li class="nav-item ps-4 pe-4 border-right">
              <a class="nav-link text-dark p-0" href="{{ path('app_front_list') }}">Posts</a>
            </li>
            {% if app.user is not null %}
            <li class="nav-item ps-4 pe-4 border-right">
              <a class="nav-link text-dark p-0" href="{{ path('app_reclamation_controller_php_index') }}">Reclamations</a>
            </li>
            {% endif %}
            {% if app.user is not null %}
              <li class="nav-item ps-4 pe-4 border-right">
                <a class="nav-link text-dark p-0" href="{{ path('profile_patient') }}">My profile</a>
              </li>
            {% endif %}
          </ul>
          
          <!-- Cart Icon -->
          <a href="{{ path('view_cart') }}" class="cart-icon ms-3">
            🛒
            <span id="cart-count">
              {% if app.user %}
                {{ app.user.commandes|filter(c => c.statut == 'pending')|length }}
              {% else %}
                0
              {% endif %}
            </span>
          </a>
          <!-- Heart Icon (Favorites) -->
         <a href="{{ path('favorites') }}" class="cart-icon ms-3">
  ❤️
  <span id="favorite-count">
    {% if app.user %}
      {{ app.user.favoris|length }}
    {% else %}
      0
    {% endif %}
  </span>
</a>
        </div>
      </div>
    </nav>
  </header>
  {% endblock %}
  {% block body %}
  {% endblock %}

  {% block footer %}
  <footer id="footer" class="overflow-hidden padding-large pb-0">
    <div class="container">
      <div class="row d-flex flex-wrap justify-content-between">
        <div class="col-lg-4 col-md-6 col-sm-6 pb-3">
          <div class="footer-menu">
            <img src="{{ asset('assetsFrontOffice/images/logo.svg') }}" alt="logo" width="150">
            <p>Our application is designed to simplify the management of your categories and products, offering an intuitive interface and powerful features for an optimal user experience.</p>
            <div class="contact-item">
              <p>
                <svg class="location primary-color" width="25" height="25">
                  <use xlink:href="#location"></use>
                </svg>
                <span>Pôle Technologique El Ghazela, Ariana, Tunisia</span>
              </p>
              <p>
                <svg class="email primary-color" width="25" height="25">
                  <use xlink:href="#email"></use>
                </svg>
                <a href="mailto:">sahateck@gmail.com</a>
              </p>
              <p>
                <svg class="phone primary-color" width="25" height="25">
                  <use xlink:href="#phone"></use>
                </svg>
                <span>70 685 685</span>
              </p>
              <ul class="social-links list-unstyled d-flex mt-3">
                <li>
                  <a href="#">
                    <svg class="facebook text-primary-500 me-3" width="25" height="25">
                      <use xlink:href="#facebook"></use>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="#">
                    <svg class="twitter text-primary-500 me-3" width="25" height="25">
                      <use xlink:href="#twitter"></use>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="#">
                    <svg class="instagram text-primary-500 me-3" width="25" height="25">
                      <use xlink:href="#instagram"></use>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="#">
                    <svg class="youtube text-primary-500 me-3" width="25" height="25">
                      <use xlink:href="#youtube"></use>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="#">
                    <svg class="linkedin text-primary-500" width="25" height="25">
                      <use xlink:href="#linkedin"></use>
                    </svg>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-sm-6 pb-3">
          <div class="footer-menu">
            <h5 class="widget-title fw-semibold">Opening Hours</h5>
            <table class="schedule">
              <tr class="d-flex justify-content-between border-bottom py-2">
                <td>Monday - Thursday</td>
                <td class="text-primary">8:00 am - 6:00 pm</td>
              </tr>
              <tr class="d-flex justify-content-between border-bottom py-2">
                <td>Friday - Saturday</td>
                <td class="text-primary">10:00 am - 4:00 pm</td>
              </tr>
              <tr class="d-flex justify-content-between border-bottom py-2">
                <td>Sunday</td>
                <td class="text-primary">Emergency only</td>
              </tr>
              <tr class="d-flex justify-content-between border-bottom py-2">
                <td>Personal</td>
                <td class="text-primary">7:00 pm - 9:00 pm</td>
              </tr>
            </table>
          </div>
        </div>
      </div>
      <div class="d-md-flex text-center justify-content-between border-top mt-5 py-4">
        <p>&copy; {{ "now"|date("Y") }} <strong><span>SAHATECK</span></strong>. - All rights reserved</p>
      </div>
    </div>
  </footer>
  {% endblock %}
</body>
</html>