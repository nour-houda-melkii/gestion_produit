{% extends 'base.html.twig' %}

{% block title %}Register as Patient{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/logins/login-3/assets/css/login-3.css">
    <style>
        html, body {
            overflow: hidden;
            height: 100%;
            margin: 0;
        }
        .login-page {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container-fluid, .row {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
        }
        .col-6 {
            flex: 0 0 50%;
            max-width: 50%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="container-fluid">
            <div class="row g-0">
                <div class="col-6" style="background-color: #CAF0F8; border-color: #CAF0F8;">
                    <div class="d-flex justify-content-center align-items-center h-100 p-3 p-md-4 p-xl-5">
                        <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/undraw_hello_ccwj.svg') }}" width="350" height="80" alt="BootstrapBrain Logo">
                    </div>
                </div>
                <div class="col-6 bsb-tpl-bg-lotion">
                    <div class="p-3 p-md-4 p-xl-5">
                        <div class="d-flex flex-column align-items-center">
                            <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/logo.png') }}" width="100" height="80" alt="Logo">
                            <h3>Create your account as Patient</h3>
                        </div>

                        {{ form_errors(registrationForm) }}

                        {{ form_start(registrationForm, {'attr': {'class': 'row gy-3 gy-md-4 overflow-hidden', novalidate: 'novalidate'}}) }}
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="col-12">
                                        <label>First Name</label>
                                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.firstName) }}
                                    </div>
                                    <div class="col-12">
                                        <label>Email</label>
                                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.email) }}
                                    </div>
                                    <div class="col-12">
                                        <label>Adress</label>
                                        {{ form_widget(registrationForm.adress, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.adress) }}
                                    </div>
                                    <div class="col-12">
                                        <label>Age</label>
                                        {{ form_widget(registrationForm.age, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.age) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="col-12">
                                        <label>Last Name</label>
                                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.lastName) }}
                                    </div>
                                    <div class="col-12">
                                        <label>Phone Number</label>
                                        {{ form_widget(registrationForm.phoneNumber, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.phoneNumber) }}
                                    </div>
                                    <div class="col-12">
                                        <label>Gender</label>
                                        {{ form_widget(registrationForm.gender, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.gender) }}
                                    </div>
                                    <div class="col-12">
                                        <label>Password</label>
                                        {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(registrationForm.plainPassword) }}
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="d-grid">
                                    <button type="submit" class="btn bsb-btn-xl text-white" style="background-color: #00B4D8; border-color: #00B4D8; padding: 8px 16px; font-size: 14px;">Register</button>
                                </div>
                            </div>
                        {{ form_end(registrationForm) }}

                        <div class="row">
                            <div class="col-12">
                                <hr class="border-secondary-subtle">
                                <div class="text-end">
                                    <a href="{{ path('app_login') }}" class="link-secondary text-decoration-none">Already have an account? Sign in</a>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <p class="">Or sign up with</p>
                                <div class="d-flex gap-3 flex-column flex-xl-row">
                                    <a href="#!" class="btn btn-lg btn-outline-danger p-2 lh-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                                            <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z" />
                                        </svg>
                                    </a>
                                    <a href="#!" class="btn btn-lg btn-outline-primary p-2 lh-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-facebook" viewBox="0 0 16 16">
                                            <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    console.log("Script chargé !");
});
</script>
{% endblock %}