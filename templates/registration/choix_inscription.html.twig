{# templates/registration/choix_inscription.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Choisir votre espace{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/logins/login-3/assets/css/login-3.css">
    <style>
        html, body {
            overflow: hidden;
            height: 100%;
            margin: 0; /* Supprime les marges par défaut */
        }
        .login-page {
            height: 100vh; /* Prend toute la hauteur de la vue */
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container-fluid, .row {
            height: 100%;
            width: 100%;
            margin: 0; /* Supprime les marges par défaut */
            padding: 0; /* Supprime les paddings par défaut */
        }
        .col-6 {
            flex: 0 0 50%; /* Force chaque colonne à prendre exactement 50% de la largeur */
            max-width: 50%; /* Limite la largeur à 50% */
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0; /* Supprime les paddings par défaut */
        }
    </style>
{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="container-fluid"> <!-- Utilisation de container-fluid pour une largeur totale -->
            <div class="row g-0"> <!-- Supprime les espacements entre les colonnes -->
                <!-- Colonne de gauche : Image -->
                <div class="col-6" style="background-color: #CAF0F8; border-color: #CAF0F8;">
                    <div class="d-flex justify-content-center align-items-center h-100 p-3 p-md-4 p-xl-5">
                        <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsFrontOffice/images/undraw_choice_dzxz.svg') }}" width="350" height="80" alt="BootstrapBrain Logo">
                    </div>
                </div>

                <!-- Colonne de droite : Formulaire de choix -->
                <div class="col-6 bsb-tpl-bg-lotion">
                    <div class="p-3 p-md-4 p-xl-5">
                        <div class="d-flex flex-column align-items-center">
                            <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/logo.png') }}" width="100" height="80" alt="Logo">
                            <h3>Choisissez votre espace</h3>
                        </div>

                        <div class="row gy-3 gy-md-4 overflow-hidden">
                            <div class="col-12 text-center">
                                <a href="{{ path('app_register_patient') }}" class="btn btn-primary btn-lg" style="background-color: #00B4D8; border-color: #00B4D8; padding: 8px 16px; font-size: 14px;">Espace Patient</a>
                            </div>
                            <div class="col-12 text-center">
                                <a href="{{ path('app_register_medecin') }}" class="btn btn-secondary btn-lg" style="background-color: #6c757d; border-color: #6c757d; padding: 8px 16px; font-size: 14px;">Espace Médecin</a>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <hr class="border-secondary-subtle">
                                <div class="text-end">
                                    <a href="{{ path('app_login') }}" class="link-secondary text-decoration-none">Déjà un compte ? Connectez-vous</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}