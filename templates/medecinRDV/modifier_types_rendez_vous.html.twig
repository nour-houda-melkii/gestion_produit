{% extends 'baseBackOffice.html.twig' %}

{% block body %}
<main id="main" class="main">
    <h1>Modifier les types de rendez-vous</h1>

    <h2>Types activés</h2>
    <ul class="list-group">
        {% for type in activeTypes %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>{{ type | capitalize }}</span>
                <form action="{{ path('modifier_types_rendez_vous') }}" method="POST">
                    <input type="hidden" name="type" value="{{ type }}">
                    <input type="hidden" name="action" value="desactiver">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                </form>
            </li>
        {% endfor %}
    </ul>

    <h2 class="mt-4">Types désactivés</h2>
    <ul class="list-group">
        {% for type in inactiveTypes %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>{{ type | capitalize }}</span>
                <form action="{{ path('modifier_types_rendez_vous') }}" method="POST">
                    <input type="hidden" name="type" value="{{ type }}">
                    <input type="hidden" name="action" value="activer">
                    <button type="submit" class="btn btn-sm btn-outline-success">Activer</button>
                </form>
            </li>
        {% endfor %}
    </ul>

    
</main>
{% endblock %}
