{% extends 'baseBackOffice.html.twig' %}

{% block body %}
<main id="main" class="main">
    <h1>Modifier la date et l'heure du rendez-vous</h1>

    <p><strong>Patient :</strong> {{ rendezVous.getPatient().getUser().getFirstName() }} {{ rendezVous.getPatient().getUser().getLastName() }}</p>
    

    {{ form_start(form) }}

    <div class="mb-3">
        {{ form_label(form.date) }}
        {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.date) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.heure) }}
        {{ form_widget(form.heure, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.heure) }}
    </div>

    <button type="submit" class="btn btn-primary">Modifier</button>
    <a href="{{ path('medecin_liste_rdv') }}" class="btn btn-secondary">Annuler</a>

    {{ form_end(form) }}
</main>
{% endblock %}
