{# templates/commande/cart_content.html.twig #}

{% if commande and commande.commandeLignes|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for ligne in commande.commandeLignes %}
                <tr>
                    <td>{{ ligne.produit.name }}</td>
                    <td>{{ ligne.produit.price }} Dt</td>
                    <td>
                        <button onclick="updateQuantity({{ ligne.id }}, -1)" class="btn btn-secondary btn-sm">-</button>
                        <span id="quantity-{{ ligne.id }}">{{ ligne.quantity }}</span>
                        <button onclick="updateQuantity({{ ligne.id }}, 1)" class="btn btn-secondary btn-sm">+</button>
                    </td>
                    <td id="total-{{ ligne.id }}">{{ ligne.produit.price * ligne.quantity }} Dt</td>
                    <td>
                        <button onclick="removeFromCart({{ ligne.id }})" class="btn btn-danger btn-sm">Delete</button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total</th>
                <th id="cart-total">{{ commande.total }} Dt</th>
            </tr>
        </tfoot>
    </table>
{% else %}
    <p>Your cart is empty.</p>
{% endif %}