{% extends 'baseBackOffice.html.twig' %}

{% block title %}TypeReclamation index{% endblock %}

{% block body %}
  <main id="main" class="main">
  <div class="type-reclamation-container">
 

    <table class="table">
      <thead>
        <tr>
          <th>Type_reclamation</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for type_reclamation in type_reclamations %}
          <tr>
            <td>{{ type_reclamation.typeReclamation }}</td>
            <td class="actions">
              <a href="{{ path('app_type_reclamation_controller_php_show', {'id': type_reclamation.id}) }}">Show</a>
              <a href="{{ path('app_type_reclamation_controller_php_edit', {'id': type_reclamation.id}) }}">Edit</a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="3" class="no-records">No records found</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <a href="{{ path('app_type_reclamation_controller_php_new') }}" class="create-new-link">Create new</a>
  </div>
  </main>
<style>
  .type-reclamation-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 20px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    margin-top: 100px;
  }

  .type-reclamation-container h1 {
    text-align: center;
    color: #2c3e50;
    margin-bottom: 30px;
    font-size: 28px;
    font-weight: 600;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 100px;
  }

  .table th,
  .table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }

  .table th {
    background-color: #00B4D8;
    color: white;
    font-weight: 500;
  }

  .table tr:hover {
    background-color: #f9f9f9;
  }

  .actions a {
    display: inline-block;
    margin-right: 10px;
    padding: 6px 12px;
    border-radius: 5px;
    text-decoration: none;
    color: white;
    background-color: #00B4D8;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .actions a:hover {
    background-color: #0099b3;
    transform: translateY(-2px);
  }

  .create-new-link {
    display: inline-block;
    padding: 12px 24px;
    background-color: #00B4D8;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-size: 16px;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .create-new-link:hover {
    background-color: #0099b3;
    transform: translateY(-2px);
  }

  .no-records {
    text-align: center;
    color: #888;
    font-style: italic;
    padding: 20px;
  }
</style>
{% endblock %}