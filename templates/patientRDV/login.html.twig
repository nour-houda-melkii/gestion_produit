{# templates/patient/login.html.twig #}
{% extends 'baseFrontOffice.html.twig' %}

{% block title %}Connexion Patient{% endblock %}

{% block body %}
<div class="container my-5">
    <h2>Connexion Patient</h2>

    {% for flashMessage in app.flashes('error') %}
        <div class="alert alert-danger">{{ flashMessage }}</div>
    {% endfor %}

    <form method="post">
        <div class="mb-3">
            <label for="id_patient" class="form-label">ID Patient :</label>
            <input type="text" id="id_patient" name="id_patient" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Se Connecter</button>
    </form>
</div>
{% endblock %}