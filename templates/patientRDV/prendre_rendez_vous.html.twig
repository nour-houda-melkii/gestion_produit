{# templates/patient/prendre_rendez_vous.html.twig #}
{% extends 'baseFrontOffice.html.twig' %}

{% block title %}Prendre un Rendez-Vous{% endblock %}

{% block body %}
<div class="container my-5">
    <h2>Prendre un Rendez-Vous</h2>
    {% for flashMessage in app.flashes('error') %}
    <div class="alert alert-danger">{{ flashMessage }}</div>
{% endfor %}

    <p><strong>Médecin :</strong> {{ medecin.getUser().getLastName() }} {{ medecin.getUser().getFirstName() }}</p>

    {{ form_start(form) }}
    <div class="mb-3">
        {{ form_label(form.date) }}
        {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.date) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.heure) }}
        {{ form_widget(form.heure, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.heure) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.etat) }}
        {{ form_widget(form.etat, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.etat) }}
    </div>
    <button type="submit" class="btn btn-primary">Confirmer</button>
    {{ form_end(form) }}
</div>


{% endblock %}