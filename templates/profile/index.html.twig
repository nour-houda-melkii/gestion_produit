{# templates/profile/index.html.twig #}
{% extends 'baseBackOffice.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
  <main id="main" class="main">
    <div class="pagetitle">
      <h1>Profile</h1>
      {# <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="">Home</a></li>
          <li class="breadcrumb-item">Users</li>
          <li class="breadcrumb-item active">Profile</li>
        </ol>
      </nav> #}
    </div><!-- End Page Title -->

    <section class="section profile">
      <div class="row">
        <div class="col-xl-4">
          <div class="card">
            <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">
              {# <img src="{{ asset('assets/img/profile-img.jpg') }}" alt="Profile" class="rounded-circle"> #}
              <h2>{{ user.firstName }} {{ user.lastName }}</h2>
              <h3>
                {% if 'ROLE_MEDECIN' in user.roles %}
                  Médecin
                {% elseif 'ROLE_USER' in user.roles %}
                  Patient
                {% endif %}
              </h3>
              <div class="social-links mt-2">
                <a href="#" class="twitter"><i class="bi bi-twitter"></i></a>
                <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-8">
          <div class="card">
            <div class="card-body pt-3">
              <!-- Bordered Tabs -->
              <ul class="nav nav-tabs nav-tabs-bordered">
                <li class="nav-item">
                  <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-overview">Aperçu</button>
                </li>
                <li class="nav-item">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-edit">Modifier le profil</button>
                </li>

                {# Afficher l'onglet Settings uniquement pour les patients #}
                {% if 'ROLE_USER' in user.roles %}
                  <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-settings">Dossier Médical</button>
                  </li>
                {% endif %}

                <li class="nav-item">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-change-password">Changer le mot de passe</button>
                </li>
              </ul>

              <div class="tab-content pt-2">
                <div class="tab-pane fade show active profile-overview" id="profile-overview">
                  <h5 class="card-title">About</h5>
                  <p class="small fst-italic">Bienvenue sur votre profil. Vous pouvez consulter et modifier vos informations personnelles ici.</p>

                  <h5 class="card-title">Détails du Profil</h5>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Nom Complet</div>
                    <div class="col-lg-9 col-md-8">{{ user.firstName }} {{ user.lastName }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Email</div>
                    <div class="col-lg-9 col-md-8">{{ user.email }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Téléphone</div>
                    <div class="col-lg-9 col-md-8">{{ user.phoneNumber }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Adresse</div>
                    <div class="col-lg-9 col-md-8">{{ user.adress }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Âge</div>
                    <div class="col-lg-9 col-md-8">{{ user.age }}</div>
                  </div>

                  <div class="row">
                    <div class="col-lg-3 col-md-4 label">Genre</div>
                    <div class="col-lg-9 col-md-8">{{ user.gender ? user.gender.value : 'Non spécifié' }}</div>
                  </div>


                  {% if 'ROLE_MEDECIN' in user.roles %}
                    <div class="row">
                      <div class="col-lg-3 col-md-4 label">Spécialité</div>
                      <div class="col-lg-9 col-md-8">{{ user.specialite.value }}</div>
                    </div>

                    <div class="row">
                      <div class="col-lg-3 col-md-4 label">Numéro de Licence</div>
                      <div class="col-lg-9 col-md-8">{{ user.numeroLicence }}</div>
                    </div>
                  {% endif %}
                </div><!-- End Overview Tab -->

                <div class="tab-pane fade profile-edit pt-3" id="profile-edit">
                  <!-- Profile Edit Form -->
                  {{ form_start(profileForm) }}
                    {# <div class="row mb-3">
                      <label class="col-md-4 col-lg-3 col-form-label">Image de Profil</label>
                      <div class="col-md-8 col-lg-9">
                        <img src="{{ asset('assets/img/profile-img.jpg') }}" alt="Profile">
                        <div class="pt-2">
                          <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-upload"></i></a>
                          <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                        </div>
                      </div>
                    </div> #}

                    <div class="row mb-3">
                      {{ form_label(profileForm.firstName, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.firstName, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      {{ form_label(profileForm.lastName, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.lastName, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      {{ form_label(profileForm.email, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      {{ form_label(profileForm.phoneNumber, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.phoneNumber, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      {{ form_label(profileForm.adress, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.adress, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      {{ form_label(profileForm.age, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.age, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      {{ form_label(profileForm.gender, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(profileForm.gender, {'attr': {'class': 'form-control'}}) }}
                      </div>
                    </div>

                    {% if 'ROLE_MEDECIN' in user.roles %}
                      <div class="row mb-3">
                        {{ form_label(profileForm.specialite, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                        <div class="col-md-8 col-lg-9">
                          {{ form_widget(profileForm.specialite, {'attr': {'class': 'form-control'}}) }}
                        </div>
                      </div>

                      <div class="row mb-3">
                        {{ form_label(profileForm.numeroLicence, null, {'label_attr': {'class': 'col-md-4 col-lg-3 col-form-label'}}) }}
                        <div class="col-md-8 col-lg-9">
                          {{ form_widget(profileForm.numeroLicence, {'attr': {'class': 'form-control'}}) }}
                        </div>
                      </div>
                    {% endif %}

                    <div class="text-center">
                      <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                    </div>
                  {{ form_end(profileForm) }}
                </div><!-- End Profile Edit Form -->

                {# Afficher l'onglet Settings uniquement pour les patients #}
                {% if 'ROLE_USER' in user.roles %}
                  <div class="tab-pane fade pt-3" id="profile-settings">
                    <!-- Settings Form -->
                    {{ form_start(medicalFileForm) }}
                      <div class="row mb-3">
                        <label for="medicalFile" class="col-md-4 col-lg-3 col-form-label">Dossier Médical</label>
                        <div class="col-md-8 col-lg-9">
                          {{ form_widget(medicalFileForm.medicalFile, {'attr': {'class': 'form-control'}}) }}
                          <small class="text-muted">Téléversez votre dossier médical (PDF, JPEG, PNG).</small>
                        </div>
                      </div>

                      <div class="text-center">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                      </div>
                    {{ form_end(medicalFileForm) }}
                  </div>
                {% endif %}

                <div class="tab-pane fade pt-3" id="profile-change-password">
                  <!-- Change Password Form -->
                  {{ form_start(changePasswordForm, {'attr': {'class': 'form', novalidate: 'novalidate'}}) }}
                    <div class="row mb-3">
                      <div class="col-md-4 col-lg-3 col-form-label">
                        {{ form_label(changePasswordForm.currentPassword) }}
                      </div>
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(changePasswordForm.currentPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(changePasswordForm.currentPassword) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      <div class="col-md-4 col-lg-3 col-form-label">
                        {{ form_label(changePasswordForm.newPassword) }}
                      </div>
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(changePasswordForm.newPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(changePasswordForm.newPassword) }}
                      </div>
                    </div>

                    <div class="row mb-3">
                      <div class="col-md-4 col-lg-3 col-form-label">
                        {{ form_label(changePasswordForm.confirmPassword) }}
                      </div>
                      <div class="col-md-8 col-lg-9">
                        {{ form_widget(changePasswordForm.confirmPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(changePasswordForm.confirmPassword) }}
                      </div>
                    </div>

                    <div class="text-center">
                      <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                    </div>
                  {{ form_end(changePasswordForm) }}
                </div><!-- End Change Password Form -->
              </div><!-- End Bordered Tabs -->
            </div>
          </div>
        </div>
      </div>
    </section>
  </main><!-- End #main -->
{% endblock %}