{# templates/patient/show.html.twig #}

{% extends 'baseBackOffice.html.twig' %}

{% block title %}Détails du Patient - SAHATECK{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="{{ asset('assetsBackOffice/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/boxicons/css/boxicons.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/quill/quill.snow.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/quill/quill.bubble.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/remixicon/remixicon.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/simple-datatables/style.css') }}" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="{{ asset('assetsBackOffice/css/style.css') }}" rel="stylesheet">

    <!-- Favicon -->
    <link href="{{ asset('assetsBackOffice/img/favicon.png') }}" rel="icon">
    <link href="{{ asset('assetsBackOffice/img/apple-touch-icon.png') }}" rel="apple-touch-icon">

    <style>
        .label {
            color: rgb(31, 31, 34);
            font-weight: 600;
            font-size: 16px;
        }
    </style>
{% endblock %}

{% block body %}
    <main id="main" class="main">
        <div class="container mt-5">
            <div class="card">
                <div class="card-body">
                    <!-- Section "About" -->
                    <div class="tab-pane fade show active profile-overview" id="profile-overview">
                        <h5 class="card-title">About</h5>
                        <p class="small fst-italic" style="font-family: 'Poppins', sans-serif; font-weight: 200; font-size: 13px;">
                            Retrouvez ici les détails complets du patient. Vous pouvez consulter ses informations personnelles.
                        </p>

                        <h5 class="card-title">Détails du Profil</h5>

                        <!-- Full Name -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Nom Complet</div>
                            <div class="col-lg-9 col-md-8">{{ patient.firstName }} {{ patient.lastName }}</div>
                        </div>

                        <!-- Email -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Email</div>
                            <div class="col-lg-9 col-md-8">{{ patient.email }}</div>
                        </div>

                        <!-- Genre -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Genre</div>
                            <div class="col-lg-9 col-md-8">{{ patient.gender ? patient.gender.value : 'Non spécifié' }}</div>
                        </div>

                        <!-- Adresse -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Adresse</div>
                            <div class="col-lg-9 col-md-8">{{ patient.adress }}</div>
                        </div>

                        <!-- Téléphone -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Téléphone</div>
                            <div class="col-lg-9 col-md-8">{{ patient.phoneNumber }}</div>
                        </div>

                        <!-- Âge -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Âge</div>
                            <div class="col-lg-9 col-md-8">{{ patient.age ?? 'Non spécifié' }}</div>
                        </div>
<!-- Dossier Médical -->
<div class="row">
    <div class="col-lg-3 col-md-4 label">Dossier Médical</div>
    <div class="col-lg-9 col-md-8">
        {% if patient.medicalFile %}
            <a href="{{ asset('uploads/' ~ patient.medicalFile) }}" target="_blank" class="btn btn-primary btn-sm">
                <i class="bi bi-eye"></i> Afficher le dossier médical
            </a>
                <a href="{{ path('download_medical_file', {'filename': patient.medicalFile}) }}" class="btn btn-success btn-sm">
                    <i class="bi bi-download"></i> Télécharger le dossier médical
                </a>
        {% else %}
            <span class="text-muted">Aucun dossier médical téléversé.</span>
        {% endif %}
    </div>
</div>
                        </div>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="mt-4">
                        <a href="{{ path('app_patient_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Retour à la liste
                        </a>
                        <a href="{{ path('app_patient_edit', {'id': patient.id}) }}" class="btn btn-warning" style="background-color: #00B4D8; color: white; border: none;">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <!-- Vendor JS Files -->
    <script src="{{ asset('assetsBackOffice/vendor/apexcharts/apexcharts.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/chart.js/chart.umd.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/echarts/echarts.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/quill/quill.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/simple-datatables/simple-datatables.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/tinymce/tinymce.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/php-email-form/validate.js') }}"></script>

    <!-- Template Main JS File -->
    <script src="{{ asset('assetsBackOffice/js/main.js') }}"></script>
{% endblock %}