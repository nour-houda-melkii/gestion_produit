{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/logins/login-3/assets/css/login-3.css">
    <style>
        html, body {
            overflow: hidden;
            height: 100%;
            margin: 0; /* Supprime les marges par défaut */
        }
        .login-page {
            height: 100vh; /* Prend toute la hauteur de la vue */
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container-fluid, .row {
            height: 100%;
            width: 100%;
            margin: 0; /* Supprime les marges par défaut */
            padding: 0; /* Supprime les paddings par défaut */
        }
        .col-6 {
            flex: 0 0 50%; /* Force chaque colonne à prendre exactement 50% de la largeur */
            max-width: 50%; /* Limite la largeur à 50% */
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0; /* Supprime les paddings par défaut */
        }
    </style>
{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="container-fluid"> <!-- Utilisation de container-fluid pour une largeur totale -->
            <div class="row g-0"> <!-- Supprime les espacements entre les colonnes -->
                <div class="col-6" style="background-color: #CAF0F8; border-color: #CAF0F8;">
                    <div class="d-flex justify-content-center align-items-center h-100 p-3 p-md-4 p-xl-5">
                        <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/undraw_forgot-password_odai.svg') }}" width="245" height="80" alt="BootstrapBrain Logo">
                    </div>
                </div>
                <div class="col-6 bsb-tpl-bg-lotion">
                    <div class="p-3 p-md-4 p-xl-5">
                        <div class="d-flex flex-column align-items-center">
                            <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/logo.png') }}" width="100" height="80" alt="Logo">
                            <h3>Reset your password</h3>
                        </div>
                        {% for flash_error in app.flashes('reset_password_error') %}
                            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                        {% endfor %}
                        {{ form_start(requestForm, {'attr': {'class': 'row gy-3 gy-md-4 overflow-hidden', novalidate: 'novalidate'}}) }}
                            <div class="col-12">
                                <label>Email</label>
                                {{ form_widget(requestForm.email, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(requestForm.email) }}
                                <small class="text-muted">
                                    Enter your email address, and we will send you a link to reset your password.
                                </small>
                            </div>
                            <div class="col-12">
                                <div class="d-grid">
                                    <button type="submit" class="btn bsb-btn-xl text-white" style="background-color: #00B4D8; border-color: #00B4D8; padding: 8px 16px; font-size: 14px;">Send password reset email</button>
                                </div>
                            </div>
                        {{ form_end(requestForm) }}
                        <div class="row">
                            <div class="col-12">
                                <hr class="border-secondary-subtle">
                                <div class="text-end">
                                    <a href="{{ path('app_login') }}" class="link-secondary text-decoration-none">Back to login</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}